<!-- 老人个人信息页面 -->
<view class="profile-container">
  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>
  
  <!-- 用户身份卡片 -->
  <view class="identity-card">
    <view class="avatar-wrapper">
      <image 
        src="{{userInfo.avatar || ''}}" 
        class="avatar"
        mode="aspectFill"
      ></image>
    </view>
    <view class="identity-info">
      <text class="user-name">{{userInfo.name}}</text>
      <text class="user-id">ID: {{userInfo.id}}</text>
    </view>
  </view>
  
  <!-- 编辑按钮 -->
  <view class="edit-btn-container">
    <button class="edit-btn" bindtap="showEditModal">编辑信息</button>
  </view>

  <!-- 基本信息 -->
  <view class="info-section">
    <view class="section-title">
      <text class="title-icon">📋</text>
      <text>基本信息</text>
    </view>
    <view class="info-list">
      <view class="info-item">
        <text class="info-label">姓名</text>
        <text class="info-value">{{userInfo.name}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">用户ID</text>
        <text class="info-value">{{userInfo.id}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">性别</text>
        <text class="info-value">{{userInfo.sex}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">邮箱</text>
        <text class="info-value">{{userInfo.email}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">联系电话</text>
        <text class="info-value">{{userInfo.phone}}</text>
      </view>
      <view class="info-item">
        <text class="info-label">备注</text>
        <text class="info-value">{{userInfo.remark}}</text>
      </view>
    </view>
  </view>

  <!-- 紧急联系人 -->
  <view wx:if="{{emergencyContacts && emergencyContacts.length > 0}}" class="info-section">
    <view class="section-title">
      <text class="title-icon">🚨</text>
      <text>紧急联系人</text>
    </view>
    <!-- 紧急联系人列表 -->
    <view class="emergency-contacts-list">
      <view wx:for="{{emergencyContacts}}" wx:key="contactsId" class="emergency-contact-item">
        <view class="contact-header">
          <text class="contact-name">{{item.name || '暂无'}}</text>
          <text class="contact-type">紧急联系人</text>
        </view>
        <view class="contact-details">
          <view class="info-item">
            <text class="info-label">联系电话</text>
            <text class="info-value">{{item.phone || '暂无'}}</text>
          </view>
          <view class="info-item">
            <text class="info-label">备注</text>
            <text class="info-value">{{item.remark || '暂无'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  
  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="logout-button" bindtap="logout">退出登录</button>
  </view>
  
  <!-- 编辑信息模态框 -->
  <view wx:if="{{showEditModal}}" class="modal-overlay" bindtap="hideEditModal">
    <view class="modal-content" catchtap="noop">
      <view class="modal-header">
        <text class="modal-title" style="width: 500rpx;">编辑个人信息</text>
        <button class="modal-close" bindtap="hideEditModal">×</button>
      </view>
      <view class="modal-body">
        <form bindsubmit="submitEditForm">
          <!-- 姓名 -->
          <view class="form-item">
            <text class="form-label">姓名</text>
            <input 
              name="nickName" 
              class="form-input" 
              placeholder="请输入姓名"
              value="{{editForm.nickName}}"
            />
          </view>
          <!-- 邮箱 -->
          <view class="form-item">
            <text class="form-label">邮箱</text>
            <input 
              name="email" 
              class="form-input" 
              placeholder="请输入邮箱"
              value="{{editForm.email}}"
            />
          </view>
          <!-- 手机号 -->
          <view class="form-item">
            <text class="form-label">手机号</text>
            <input 
              name="phonenumber" 
              class="form-input" 
              placeholder="请输入手机号"
              value="{{editForm.phonenumber}}"
            />
          </view>
          <!-- 性别 -->
          <view class="form-item">
            <text class="form-label">性别</text>
            <view class="gender-select">
              <radio-group name="sex">
                <label class="radio-item">
                  <radio value="1" checked="{{editForm.sex === '1'}}" />
                  <text>男</text>
                </label>
                <label class="radio-item">
                  <radio value="0" checked="{{editForm.sex === '0'}}" />
                  <text>女</text>
                </label>
              </radio-group>
            </view>
          </view>
          <!-- 备注 -->
          <view class="form-item">
            <text class="form-label">备注</text>
            <textarea 
              name="remark" 
              class="form-textarea" 
              placeholder="请输入备注"
              value="{{editForm.remark}}"
              auto-height
            ></textarea>
          </view>
          <!-- 提交按钮 -->
          <view class="form-actions">
            <button class="cancel-btn" form-type="reset" bindtap="hideEditModal">取消</button>
            <button class="submit-btn" form-type="submit" type="primary">保存修改</button>
          </view>
        </form>
      </view>
    </view>
  </view>
</view>